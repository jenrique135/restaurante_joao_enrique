
<!-- ================= DASHBOARD.EJS ================= -->
<!DOCTYPE html>
<html>
<head>
    <title>Jenrique Restaurant - Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;600&display=swap" rel="stylesheet">

    <style>
        body{
            font-family:'Poppins',sans-serif;
            background:#f1f5f9;
            padding:20px;
        }

        h1{
            text-align:center;
            margin-bottom:30px;
            color:#1d3557;
        }

        .grid{
            display:flex;
            gap:20px;
            justify-content:center;
            flex-wrap:wrap;
        }

        .card{
            background:white;
            padding:20px;
            border-radius:15px;
            box-shadow:0 5px 20px rgba(0,0,0,0.1);
            width:300px;
        }

        input{
            width:100%;
            padding:10px;
            margin:5px 0;
            border:1px solid #ddd;
            border-radius:8px;
        }

        button{
            width:100%;
            padding:10px;
            border:none;
            border-radius:20px;
            background:#457b9d;
            color:white;
            cursor:pointer;
        }

        button:hover{background:#1d3557;}

        ul{margin-top:10px;}
    </style>
</head>
<body>

<h1>🍽️ Painel - Jenrique Restaurant</h1>

<div class="grid">
    <div class="card">
        <h3>Novo Item</h3>
        <form action="/add-item" method="POST">
            <input type="text" name="name" placeholder="Nome" required>
            <input type="text" name="category" placeholder="Categoria">
            <button type="submit">Cadastrar</button>
        </form>
    </div>

    <div class="card">
        <h3>Itens</h3>
        <ul>
            <% items.forEach(item => { %>
                <li><%= item.name %> (<%= item.category %>)</li>
            <% }) %>
        </ul>
    </div>
</div>

</body>
</html>
